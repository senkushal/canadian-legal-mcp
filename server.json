{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ca.optillium/canadian-legal-research",
  "description": "Canadian legal research MCP server using authorized Canadian legal information sources.",
  "repository": {
    "url": "https://github.com/senkushal/canadian-legal-mcp",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@optillium/canadian-legal-mcp",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "CanLII API key",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "CANLII_API_KEY"
        }
      ]
    }
  ]
}
